# ========== Generic Sys Admin - Environment Variables Template ==========
# 复制此文件为 .env 后填写真实配置
# ⚠️ 禁止提交 .env 文件到版本库！

# ========== MySQL 数据库（必填）==========
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_PASSWORD=your_database_password_here

# ========== Redis 缓存（必填）==========
REDIS_PASSWORD=your_redis_password_here

# ========== JWT 安全配置（⚠️生产必填！）==========
# 生成强随机密钥命令：
#   Windows: openssl rand -base64 64
#   Linux/Mac: openssl rand -base64 64 | tr -d '\n'
# 密钥长度至少32字符
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters

# ========== 服务端口（可选）==========
SERVER_PORT=8081

# ========== MinIO 对象存储（可选）==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=generic-sys-admin

# ========== MiniMax AI 服务（可选）==========
MINIMAX_API_URL=https://api.minimax.chat
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_APP_ID=your_app_id_here
MINIMAX_GROUP_ID=your_group_id_here

# ========== 应用配置（可选）==========
# DEMO_MODE=false
# AUDIT_ENABLED=true
# DOC_ENABLED=true
