# =============================================
# Generic Sys Admin - Environment Configuration Template
# =============================================
# Copy this file to .env and configure values for your environment.
# All sensitive values should be provided via environment variables.
# =============================================

# =============================================
# Database Configuration
# =============================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=generic_sys_admin
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=root123456

# =============================================
# Redis Configuration
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================
# JWT Authentication
# =============================================
# IMPORTANT: Change this in production to a secure random string (minimum 32 characters)
JWT_SECRET=your-256-bit-secret-key-please-override-in-production-environment
JWT_EXPIRATION=7200

# =============================================
# MinIO Object Storage
# =============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================
# Server Configuration
# =============================================
SERVER_PORT=8080
SPRING_PROFILES=prod

# =============================================
# Feature Toggles
# =============================================
DEMO_MODE=false

# =============================================
# Frontend Configuration
# =============================================
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080
