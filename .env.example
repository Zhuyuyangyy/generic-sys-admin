# =============================================
# ERMS - Environment Configuration Template
# =============================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.
# =============================================

# =============================================
# Database Configuration
# =============================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=generic_sys_admin
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=root123456

# =============================================
# Redis Configuration
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================
# JWT Authentication
# =============================================
# IMPORTANT: Generate a secure random string for production (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=please-change-this-secret-in-production-at-least-32-chars
JWT_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=604800

# =============================================
# MinIO Object Storage (optional, use with --profile storage)
# =============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================
# Minimax AI Service (optional)
# =============================================
MINIMAX_APP_ID=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# =============================================
# Server Configuration
# =============================================
SERVER_PORT=8080
SPRING_PROFILES=prod
DEMO_MODE=false

# =============================================
# Frontend Configuration
# =============================================
FRONTEND_PORT=80
