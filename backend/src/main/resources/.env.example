# =============================================
# Generic SysAdmin - 环境变量模板
# 复制为 .env 后填入真实值
# =============================================

# ---- MiniMax TTS API（必须）----
# 获取地址：https://www.minimachat.com/
MINIMAX_API_KEY=你的MiniMax API Key
MINIMAX_API_URL=https://api.us-west-2.modal.direct
MINIMAX_APP_ID=dummy-app-id
MINIMAX_GROUP_ID=dummy-group-id

# ---- 数据库（必须）----
DB_PASSWORD=1234

# ---- JWT Secret（生产必须换）----
# 生成方法: openssl rand -base64 48
JWT_SECRET=

# ---- Redis（可选）----
# REDIS_PASSWORD=
